MEDIA_TYPES = {
    "gif": "image/gif",
    "jpg": "image/jpeg",
    "jpeg": "image/jpeg",
    "png": "image/png",
    "pdf": "application/pdf",
    "txt": "text/plain",
    "zip": "application/zip",
}


file_name = input("File name: ").lower().strip()

name, extension = file_name.split(".")

if extension in MEDIA_TYPES:
    print(MEDIA_TYPES[extension])

else:
    print("application/octet-stream")
